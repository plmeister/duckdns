# /etc/duckdns.env — root-owned, chmod 600
#
# One group per DuckDNS token. Groups are numbered from 1 and must be
# contiguous (no gaps). Domains are written without the .duckdns.org suffix.

DUCKDNS_1_DOMAINS=mydomain,otherdomain
DUCKDNS_1_TOKEN=replace-me

# DUCKDNS_2_DOMAINS=example
# DUCKDNS_2_TOKEN=replace-me

# Optional overrides:
# DUCKDNS_IP_URL=https://api.ipify.org
# DUCKDNS_DNS_SERVER=1.1.1.1
# DUCKDNS_UPDATE_URL=https://www.duckdns.org/update
# DUCKDNS_DRY_RUN=1
# DUCKDNS_FORCE=1
